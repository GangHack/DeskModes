# Журнал — состояние машины, а не код.
last-run.log
last-run.log.old

# Копия испорченных настроек: диагностика одного случая.
settings.json.bad

# Кэш скомпилированных типов. Собирается из исходника в DisplayCore.ps1.
native-*.dll

# Превью иконки — побочный продукт Make-Icon.ps1.
preview.png

# Снимки позиций окон: HWND живут только в рамках одного logon.
window-state.json

# Последний выбранный режим: состояние машины, меняется на каждом переключении.
last-mode.json

# Проверенные режимы мониторов: разрешение и частота, которые эта машина реально
# показывала. Нужны, чтобы задать режим спящему монитору одним переходом.
display-modes.json

# Личные настройки: набор мониторов, привязки клавиш и порядок на столе у каждого
# свои. В репозитории лежит только settings.example.json, а этот файл заводится
# сам при первом запуске.
settings.json

# MultiMonitorTool Нира Софера (nirsoft.net). Кодом не используется с 7 августа
# 2026 — остаётся в папке только для ручных проверок /scomma. Чужой freeware в
# своём репозитории не место: распространять его разрешено лишь целым пакетом и
# без изменений, а антивирусы регулярно ругаются на утилиты NirSoft.
MultiMonitorTool.exe
MultiMonitorTool.chm
readme.txt

# Дневник: сколько времени в каком приложении, на каком мониторе и в каком
# режиме. Данные о человеке, а не о программе — в репозиторий им нельзя. Файл
# заводится только когда дневник включён в настройках, и его можно удалить.
activity.json

# Отчёт по дневнику. Перезаписывается при каждом открытии «Statistics…».
stats.html
