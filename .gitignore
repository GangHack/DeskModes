# Журнал — состояние машины, а не код.
last-run.log
last-run.log.old

# Копия испорченных настроек: диагностика одного случая.
settings.json.bad

# Кэш скомпилированных типов. Собирается из исходника в DisplayCore.ps1.
native-*.dll

# Превью иконки — побочный продукт Make-Icon.ps1.
preview.png

# Снимки позиций окон: HWND живут только в рамках одного logon.
window-state.json

# Последний выбранный режим: состояние машины, меняется на каждом переключении.
last-mode.json

# MultiMonitorTool Нира Софера (nirsoft.net). Кодом не используется с 7 августа
# 2026 — остаётся в папке только для ручных проверок /scomma. Чужой freeware в
# своём репозитории не место: распространять его разрешено лишь целым пакетом и
# без изменений, а антивирусы регулярно ругаются на утилиты NirSoft.
MultiMonitorTool.exe
MultiMonitorTool.chm
readme.txt
