<#
    Настройки PSScriptAnalyzer — третьи ворота в tools\check.ps1.

    Список исключений собран не из головы, а по факту прогона правил по умолчанию
    (PSScriptAnalyzer 1.25.0, 2026-08-26): 803 замечания на 10 файлов, ровно семь
    правил. Каждое разобрано и либо выключено с обоснованием ниже, либо исправлено
    руками. После этого анализатор чист, а значит любое новое замечание — новое, а
    не утонувшее в шуме.

    Единственное настоящее замечание из тех 803: `$args = New-Object ...EventArgs`
    в трёх местах тестов — присваивание автоматической переменной. Исправлено
    переименованием, а не исключением.

    Правило выключается ЦЕЛИКОМ и только тогда, когда оно спорит со стилем проекта
    осознанно. Добавляешь исключение — добавляй и строку «почему»: без неё через
    месяц никто не отличит осознанное решение от заметённого под ковёр.
#>
@{
    IncludeDefaultRules = $true

    ExcludeRules = @(
        # Цветной вывод — это и есть задача CLI и трея: человек читает «on / off /
        # primary» глазами, а не через конвейер. Write-Output вместо Write-Host
        # отдал бы эти строки в конвейер, где их ждёт вызывающий .cmd.
        'PSAvoidUsingWriteHost'

        # Правило требует -WhatIf/-Confirm у всего, что названо Set-/New-/Remove-.
        # Здесь так названы 54 ВНУТРЕННИЕ функции (New-UiTextBlock, Set-UiMode,
        # New-FakeMonitor): это не командлеты, снаружи их никто не зовёт, и
        # обвязка ShouldProcess у каждой — чистая церемония. Настоящий сухой
        # прогон уже есть и живёт там, где ему место: Set-Display.ps1 -DryRun.
        'PSUseShouldProcessForStateChangingFunctions'

        # Множественное число здесь несёт смысл: Get-DisplayModes возвращает
        # несколько режимов, Save-AppliedModes сохраняет несколько. Переименовать
        # в Get-DisplayMode — соврать про то, что функция отдаёт.
        'PSUseSingularNouns'

        # Правило смотрит только на ту же область видимости и потому здесь врёт
        # трижды: (1) Set-DisplayMode использует $Width/$Height/$Hz внутри
        # скриптблока $build (DisplayCore.ps1:2861); (2) Displays.ps1 читает
        # $NoHotkeys внутри функции (Displays.ps1:689); (3) $sender/$e — это
        # подпись обработчика .NET, а фейки в тестах обязаны повторять подпись
        # настоящей функции, даже когда сам аргумент им не нужен. Ни одного
        # настоящего попадания на 44 замечания.
        'PSReviewUnusedParameter'

        # `catch { }` здесь всегда с комментарием, объясняющим, почему ошибку
        # правильно проглотить: журнал не должен ронять переключение мониторов,
        # монитор не ответил по DDC, кнопку успели отпустить. Правило требует
        # throw или Write-Error — то есть ровно того поведения, которое в этих
        # местах и есть поломка. Комментарий обязателен, и это проверяет ревью,
        # а не анализатор.
        'PSAvoidUsingEmptyCatchBlock'

        # $sender и $e — подпись обработчика событий .NET, и обработчики их
        # действительно читают ($sender.Text, $sender.Tag, $sender.DragMove()).
        # PowerShell подставляет в $sender то же самое значение, так что затенения
        # по существу нет, а переименование — правка двух десятков строк в самом
        # хрупком коде проекта (WPF) ради имени. Единственное настоящее попадание
        # этого правила — $args в тестах — исправлено переименованием.
        'PSAvoidAssignmentToAutomaticVariable'

        # 509 замечаний из 803, и все — Information. Правило считает нарушением
        # любой позиционный вызов, включая Join-Path $root 'x' и Assert-Equal 5 $x.
        # У проекта на этот счёт есть своё правило, более узкое и более полезное:
        # имена обязательны, когда аргументов два и больше и они одного вида (см.
        # AGENTS.md и docs/notes.ru.md, «Порядок аргументов: называть, а не
        # считать»). Его держит ревью.
        'PSAvoidUsingPositionalParameters'
    )
}
