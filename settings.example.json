{
    "hotkeys": {
        "solo:DELL U2720Q": "Ctrl+Alt+F1",
        "solo:LG ULTRAGEAR": "Ctrl+Alt+F2",
        "combo:Work": "Ctrl+Alt+F3",
        "combo:Movie night": "Ctrl+Alt+F4",
        "all": "Ctrl+Alt+F5"
    },
    "maximizeRefresh": true,
    "notifications": true,
    "language": "auto",
    "layout": [
        "DELL U2720Q",
        "LG ULTRAGEAR"
    ],
    "primary": "ULTRAGEAR",
    "combos": {
        "Work": {
            "displays": ["DELL U2720Q", "LG ULTRAGEAR"],
            "primary": ""
        },
        "Movie night": {
            "displays": ["DELL U2720Q"],
            "primary": "DELL U2720Q"
        }
    },
    "restoreWindows": true,
    "restoreLastMode": true,
    "reapply": {
        "onResume": true,
        "onUnplug": true,
        "onPlug": ""
    },
    "rules": [
        { "when": "process", "process": "cs2", "mode": "solo:LG ULTRAGEAR" },
        { "when": "idle", "minutes": 30, "mode": "combo:Movie night", "back": "combo:Work", "enabled": false },
        { "when": "displays", "displays": ["DELL U2720Q", "LG ULTRAGEAR"], "mode": "combo:Work", "enabled": false }
    ],
    "hooks": {
        "combo:Movie night": { "after": "taskkill /im slack.exe" },
        "combo:Work": "C:\\tools\\morning.ps1"
    },
    "brightness": {
        "combo:Work": 80,
        "combo:Movie night": { "DELL": 25 }
    },
    "contrast": {},
    "hdr": {
        "solo:LG ULTRAGEAR": true
    },
    "stats": false,
    "audio": {
        "combo:Movie night": "DELL"
    }
}
